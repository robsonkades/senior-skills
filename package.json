{
  "name": "senior-skills-monorepo",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "description": "Feature engineering and Senior HCM documentation skills, with a cross-agent CLI",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "workspaces": [
    "packages/core",
    "packages/node",
    "packages/registry",
    "packages/installer",
    "packages/adapter-claude",
    "packages/adapter-codex",
    "packages/cli"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "rebuild": "npm run clean && npm run build",
    "typecheck": "tsc --build --force",
    "test": "npm run build && node --test \"packages/*/test/**/*.test.ts\" \"scripts/*.test.mjs\" \"skills/*/scripts/*.test.mjs\"",
    "test:only": "node --test \"packages/*/test/**/*.test.ts\" \"scripts/*.test.mjs\" \"skills/*/scripts/*.test.mjs\"",
    "lint": "eslint packages scripts \"skills/*/scripts/*.mjs\"",
    "lint:fix": "eslint packages scripts \"skills/*/scripts/*.mjs\" --fix",
    "format": "prettier --write \"**/*.{ts,js,mjs,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,mjs,json,md,yaml,yml}\"",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "verify": "npm run build && npm run check:boundaries && npm run lint && npm run format:check && npm run registry:check && npm run check:versions && npm run test:only",
    "senior-skills": "node packages/cli/bin/senior-skills.mjs",
    "registry:build": "node scripts/build-registry-index.mjs",
    "registry:check": "node scripts/build-registry-index.mjs --check",
    "check:versions": "node scripts/check-version-bumps.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/semver": "^7.5.8",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}

{
  "name": "@senior-skills/cli",
  "version": "1.0.0",
  "description": "Install, update and publish AI coding-agent skills across Claude Code, Codex and future agents",
  "keywords": [
    "senior-skills",
    "claude-code",
    "codex",
    "ai",
    "skills",
    "package-manager",
    "cli"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robsonkades/senior-skills.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "senior-skills": "bin/senior-skills.mjs"
  },
  "main": "./dist/index.js",

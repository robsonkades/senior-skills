    "@senior-skills/adapter-codex": "1.0.0",
    "@senior-skills/core": "1.0.0",
    "@senior-skills/installer": "1.0.0",
    "@senior-skills/node": "1.0.0",
    "@senior-skills/registry": "1.0.0",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1"
